PORT=4000
# Multiple origins can be comma-separated, for example:
# https://www.eternastone.com,https://eternastone.vercel.app
CORS_ORIGIN=http://localhost:5173

# Supabase project root URL, for example: https://xxxx.supabase.co
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
SUPABASE_STORAGE_BUCKET=product-images1

# Frontend API proxy. Local dev can use Vite proxy /api.
VITE_API_BASE_URL=/api

# Use a real email address here, for example admin@eternastone.com.
ADMIN_EMAIL=admin@eternastone.com

# Protect admin write APIs in production. Use a long random value and keep it secret.
ADMIN_API_TOKEN=change-this-long-random-admin-token

# Optional local convenience only. Do not set this in a public frontend deployment.
VITE_ADMIN_API_TOKEN=
